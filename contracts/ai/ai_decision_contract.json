{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OKXDogAIAnalysisResponse",
  "description": "OKX-Dog 个人量化副驾驶大模型多周期行情研判与结构化交易决策契约 (SSOT 规范定义)",
  "type": "object",
  "required": [
    "analysis_id",
    "symbol",
    "timestamp",
    "market_regime",
    "timeframe_analysis",
    "derivatives_sentiment",
    "signal",
    "trade_plan",
    "risk_assessment",
    "reasoning_summary",
    "reasoning_details"
  ],
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "type": "string",
      "description": "研判唯一标识符，标准 UUID v4 格式，用于研判结果追踪、审计与归因分析",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "symbol": {
      "type": "string",
      "description": "交易标的代码，例如 'BTC-USDT-SWAP', 'ETH-USDT-SWAP'",
      "pattern": "^[A-Z0-9]+-[A-Z0-9]+(-SWAP)?$"
    },
    "timestamp": {
      "type": "integer",
      "description": "研判生成时的 Unix 毫秒时间戳 (ms)",
      "minimum": 1700000000000
    },
    "market_regime": {
      "type": "string",
      "description": "宏观盘面结构分类：TRENDING_UP(多头趋势), TRENDING_DOWN(空头趋势), RANGING(震荡整理), VOLATILE_BREAKOUT(剧烈突破/异动)",
      "enum": [
        "TRENDING_UP",
        "TRENDING_DOWN",
        "RANGING",
        "VOLATILE_BREAKOUT"
      ]
    },
    "timeframe_analysis": {
      "type": "object",
      "description": "多周期技术面共振分析（15m, 1h, 4h, 1d）",
      "required": ["tf_15m", "tf_1h", "tf_4h", "tf_1d"],
      "additionalProperties": false,
      "properties": {
        "tf_15m": { "$ref": "#/definitions/TimeframeDetail" },
        "tf_1h": { "$ref": "#/definitions/TimeframeDetail" },
        "tf_4h": { "$ref": "#/definitions/TimeframeDetail" },
        "tf_1d": { "$ref": "#/definitions/TimeframeDetail" }
      }
    },
    "derivatives_sentiment": {
      "type": "object",
      "description": "衍生品与市场情绪专项研判",
      "required": [
        "funding_rate_bias",
        "open_interest_interpretation",
        "long_short_ratio_state",
        "sentiment_score"
      ],
      "additionalProperties": false,
      "properties": {
        "funding_rate_bias": {
          "type": "string",
          "description": "资金费率倾向",
          "enum": [
            "EXTREME_POSITIVE",
            "MODERATE_POSITIVE",
            "NEUTRAL",
            "MODERATE_NEGATIVE",
            "EXTREME_NEGATIVE"
          ]
        },
        "open_interest_interpretation": {
          "type": "string",
          "description": "全网未平仓合约量 (OI) 异动解读"
        },
        "long_short_ratio_state": {
          "type": "string",
          "description": "多空持仓人数比与大户账户比状态分析"
        },
        "sentiment_score": {
          "type": "number",
          "description": "衍生品综合情绪量化得分 (-1.0 ~ +1.0)",
          "minimum": -1.0,
          "maximum": 1.0
        }
      }
    },
    "signal": {
      "type": "object",
      "description": "最终交易决策信号与置信度",
      "required": ["action", "confidence", "urgency"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "核心操作动作",
          "enum": [
            "BUY_LONG",
            "SELL_SHORT",
            "CLOSE_POSITION",
            "HOLD_WAIT"
          ]
        },
        "confidence": {
          "type": "number",
          "description": "决策置信度打分 [0.0, 1.0]",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "urgency": {
          "type": "string",
          "description": "执行紧迫度",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      }
    },
    "trade_plan": {
      "type": "object",
      "description": "建议交易计划与量化点位参数",
      "required": [
        "intent",
        "entry_range",
        "take_profit_levels",
        "stop_loss_price",
        "risk_reward_ratio",
        "suggested_leverage",
        "order_type"
      ],
      "additionalProperties": false,
      "properties": {
        "intent": {
          "type": "string",
          "description": "战术交易逻辑分类",
          "enum": [
            "SHORT_SQUEEZE",
            "LIQUIDITY_SWEEP",
            "TREND_CONTINUATION",
            "MEAN_REVERSION",
            "BREAKOUT_FOLLOW",
            "WAIT_OBSERVE"
          ]
        },
        "entry_range": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.0 },
          "minItems": 2,
          "maxItems": 2
        },
        "take_profit_levels": {
          "type": "array",
          "items": { "$ref": "#/definitions/TakeProfitLevel" },
          "minItems": 1,
          "maxItems": 4
        },
        "stop_loss_price": { "type": "number", "minimum": 0.0 },
        "risk_reward_ratio": { "type": "number", "minimum": 0.0 },
        "suggested_leverage": { "type": "integer", "minimum": 1, "maximum": 20 },
        "order_type": {
          "type": "string",
          "enum": ["POST_ONLY", "LIMIT", "TRIGGER_LIMIT"]
        }
      }
    },
    "risk_assessment": {
      "type": "object",
      "description": "风险评估与逻辑失效边界",
      "required": [
        "key_risks",
        "invalidation_condition",
        "max_holding_time_hours"
      ],
      "additionalProperties": false,
      "properties": {
        "key_risks": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 5
        },
        "invalidation_condition": { "type": "string" },
        "max_holding_time_hours": { "type": "number", "minimum": 0.5, "maximum": 720.0 }
      }
    },
    "reasoning_summary": { "type": "string" },
    "reasoning_details": { "type": "string" }
  },
  "definitions": {
    "TimeframeDetail": {
      "type": "object",
      "required": [
        "trend",
        "key_indicators_summary",
        "support_level",
        "resistance_level"
      ],
      "additionalProperties": false,
      "properties": {
        "trend": {
          "type": "string",
          "enum": [
            "BULLISH",
            "BEARISH",
            "NEUTRAL_CHOPPY",
            "OVERBOUGHT",
            "OVERSOLD"
          ]
        },
        "key_indicators_summary": { "type": "string" },
        "support_level": { "type": "number", "minimum": 0.0 },
        "resistance_level": { "type": "number", "minimum": 0.0 }
      }
    },
    "TakeProfitLevel": {
      "type": "object",
      "required": ["price", "percentage", "description"],
      "additionalProperties": false,
      "properties": {
        "price": { "type": "number", "minimum": 0.0 },
        "percentage": { "type": "number", "minimum": 0.01, "maximum": 1.0 },
        "description": { "type": "string" }
      }
    }
  }
}

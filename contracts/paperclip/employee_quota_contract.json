{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaperclipEmployeeQuotaContract",
  "description": "OKX-Dog v6.0 员工战绩档案、算力奖励池与剩余额度契约",
  "definitions": {
    "EmployeeQuotaStatus": {
      "type": "object",
      "required": [
        "role",
        "name",
        "rolling_7d_pnl_usdt",
        "rolling_win_rate",
        "successful_hedges_count",
        "total_bonus_earned_tokens",
        "remaining_bonus_tokens",
        "deep_thinking_unlocked",
        "current_weight"
      ],
      "properties": {
        "role": { "$ref": "company_org_contract.json#/definitions/EmployeeRole" },
        "name": { "type": "string", "description": "员工姓名/代号" },
        "rolling_7d_pnl_usdt": { "type": "number", "description": "7天滚动归因净盈亏 (USDT)" },
        "rolling_win_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0, "description": "滚动胜率" },
        "successful_hedges_count": { "type": "integer", "description": "成功排雷避险次数" },
        "total_bonus_earned_tokens": { "type": "integer", "description": "历史累计获得奖励 Tokens" },
        "remaining_bonus_tokens": { "type": "integer", "minimum": 0, "description": "当前剩余可用奖励 Tokens" },
        "deep_thinking_unlocked": { "type": "boolean", "description": "是否激活深度思考特权 (<think>长链模式)" },
        "current_weight": { "type": "number", "minimum": 0, "maximum": 100, "description": "动态话语权权重 (百分比)" },
        "level_title": { "type": "string", "description": "当前职级头衔 (如 见习/骨干/王牌/合伙人)" }
      }
    },
    "CompanyQuotaOverview": {
      "type": "object",
      "required": [
        "company_name",
        "subscription_type",
        "total_bonus_pool_tokens",
        "remaining_pool_tokens",
        "employees_quota",
        "updated_at_ms"
      ],
      "properties": {
        "company_name": { "type": "string", "description": "虚拟公司名称" },
        "subscription_type": { "type": "string", "default": "LOCAL_CLI_SUBSCRIPTION", "description": "算力套餐类型" },
        "total_bonus_pool_tokens": { "type": "integer", "description": "团队历史累计奖励池" },
        "remaining_pool_tokens": { "type": "integer", "description": "团队当前剩余可用奖励池" },
        "employees_quota": {
          "type": "array",
          "items": { "$ref": "#/definitions/EmployeeQuotaStatus" },
          "description": "全体员工配额明细"
        },
        "updated_at_ms": { "type": "integer", "description": "更新毫秒时间戳" }
      }
    }
  }
}

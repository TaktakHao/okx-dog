{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaperclipTaskWebhookContract",
  "description": "OKX-Dog v6.0 Paperclip 任务事件流、投决会唤醒与仲裁工单 Webhook 契约",
  "definitions": {
    "MarketAnomalyTriggerEvent": {
      "type": "object",
      "required": ["event_id", "symbol", "trigger_type", "price", "anomaly_description", "timestamp_ms"],
      "properties": {
        "event_id": { "type": "string", "description": "唯一事件 UUID" },
        "symbol": { "type": "string", "description": "标的代码" },
        "trigger_type": {
          "type": "string",
          "enum": ["TREND_BREAKOUT", "OVERSOLD_DIVERGENCE", "DERIVATIVES_OI_SPIKE", "VOLATILITY_EXPANSION"],
          "description": "异动触发类型"
        },
        "price": { "type": "number", "description": "触发时标的最新价格" },
        "anomaly_description": { "type": "string", "description": "技术形态与指标共振简报" },
        "timestamp_ms": { "type": "integer", "description": "毫秒时间戳" }
      }
    },
    "PaperclipArbitrationTaskResponse": {
      "type": "object",
      "required": [
        "task_id",
        "symbol",
        "action",
        "consensus_score",
        "expected_rr_ratio",
        "approved_by_ceo",
        "bonus_tokens_consumed",
        "reasoning_summary"
      ],
      "properties": {
        "task_id": { "type": "string", "description": "Paperclip 工单唯一 ID" },
        "symbol": { "type": "string", "description": "标的代码" },
        "action": {
          "type": "string",
          "enum": ["BUY_LONG", "SELL_SHORT", "CLOSE_POSITION", "HOLD_WAIT"]
        },
        "consensus_score": { "type": "integer", "minimum": 0, "maximum": 100, "description": "综合仲裁共识分" },
        "expected_rr_ratio": { "type": "number", "description": "预期盈亏比" },
        "approved_by_ceo": { "type": "boolean", "description": "执行 CEO (首席仲裁官) 是否准入批准" },
        "bonus_tokens_consumed": { "type": "integer", "description": "本次深度研判消耗的员工奖励 Tokens" },
        "reasoning_summary": { "type": "string", "description": "多空博弈与仲裁结论摘要" }
      }
    }
  }
}

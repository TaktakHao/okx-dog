{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaperclipCompanyOrgContract",
  "description": "OKX-Dog v6.0 基于 Paperclip 的虚拟量化对冲基金组织架构与员工岗位职责契约",
  "definitions": {
    "EmployeeRole": {
      "type": "string",
      "enum": [
        "CHIEF_ARBITER",
        "BULL_SPECIALIST",
        "BEAR_CRITIC",
        "MACRO_NEWS",
        "MICROSTRUCTURE",
        "CFO_AUDITOR"
      ],
      "description": "虚拟量化公司 6 大员工角色枚举"
    },
    "EmployeeProfile": {
      "type": "object",
      "required": ["role", "name", "title", "department", "base_weight", "kpi_target", "is_executive"],
      "properties": {
        "role": { "$ref": "#/definitions/EmployeeRole" },
        "name": { "type": "string", "description": "员工姓名/代号" },
        "title": { "type": "string", "description": "岗位职务" },
        "department": { "type": "string", "description": "所属部门 (投决会/研判部/风控部/执行部/财务部)" },
        "base_weight": { "type": "number", "minimum": 0, "maximum": 100, "description": "基础投票/话语权权重 (百分比)" },
        "kpi_target": { "type": "string", "description": "核心长期主义考核指标" },
        "is_executive": { "type": "boolean", "description": "是否为执行管理层 (如 CEO/CFO)" },
        "avatar_icon": { "type": "string", "description": "员工头像图标标识" }
      }
    },
    "CompanyOrgChart": {
      "type": "object",
      "required": ["company_name", "ceo_role", "employees", "governance_mode", "evaluation_window_days"],
      "properties": {
        "company_name": { "type": "string", "description": "虚拟量化公司名称" },
        "ceo_role": { "$ref": "#/definitions/EmployeeRole" },
        "employees": {
          "type": "array",
          "items": { "$ref": "#/definitions/EmployeeProfile" },
          "description": "在册员工列表"
        },
        "governance_mode": { "type": "string", "enum": ["FULL_AUTONOMOUS", "SEMI_AUTO_APPROVAL", "MANUAL"] },
        "evaluation_window_days": { "type": "integer", "default": 7, "description": "滚动战绩考核周期 (天)" }
      }
    }
  }
}

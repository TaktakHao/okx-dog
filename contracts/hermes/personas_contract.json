{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HermesMultiPersonaContract",
  "description": "OKX-Dog v6.0 Hermes Agent 6 大虚拟员工角色与权限矩阵权威契约",
  "type": "object",
  "required": ["roles", "danger_endpoints", "allowed_commands"],
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "name", "title", "hermes_persona_id", "scope", "allowed_ops"],
        "properties": {
          "role": { "type": "string" },
          "name": { "type": "string" },
          "title": { "type": "string" },
          "hermes_persona_id": { "type": "string" },
          "reports_to": { "type": ["string", "null"] },
          "scope": { "type": "string" },
          "allowed_ops": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "danger_endpoints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_commands": {
      "type": "array",
      "items": { "type": "string" }
    }
  },

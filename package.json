{
  "name": "okx-dog",
  "version": "1.0.0",
  "description": "OKX-Dog 个人量化智能交易副驾驶系统 (AI Trading Co-pilot)",
  "scripts": {
    "start": "./start.sh",
    "dev": "./start.sh",
    "dev:py": "python3 start.py",
    "test:backend": ".venv/bin/pytest -v -o asyncio_mode=auto okx-dog-backend/",
    "test:ai": ".venv/bin/pytest -v okx-dog-ai/",
    "build:frontend": "cd okx-dog-frontend && npm run build",
    "docker:deploy": "./deploy_docker.sh",
    "docker:redeploy": "./deploy_docker.sh",
    "docker:logs": "docker compose logs -f",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "okx",
    "crypto",
    "trading",
    "quantitative",
    "ai",
    "llm",
    "fastapi",
    "react"
  ],
  "author": "wesson",
  "license": "MIT"
}
